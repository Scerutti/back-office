# Variables del backend del panel (BFF). Solo se leen del lado del servidor.
# Copiá este archivo a .env.local y completá los valores (los da el equipo del Core).
# NUNCA uses el prefijo NEXT_PUBLIC_ para estas variables: quedarían en el bundle del navegador.

# URL base de la API Href.Core (https en producción)
CORE_API_URL=http://localhost:8080
# Clave de la app reservada del panel (siempre "core")
CORE_APP_KEY=core
# Secreto de la app core. Solo en el servidor: nunca en el código, en el repo ni en logs.
CORE_APP_SECRET=
